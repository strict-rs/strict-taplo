# Enforce consistent line endings across all machines.
# `.gitattributes` overrides local `core.autocrlf`, so these settings apply
# regardless of local Git configuration. See:
# https://git-scm.com/docs/gitattributes

# Default to text normalization with LF in the index and checkout.
* text=auto eol=lf

# Windows command scripts are the narrow CRLF exception: `cmd.exe` can misbehave
# with LF-only batch labels / `goto`.
*.bat text eol=crlf
*.cmd text eol=crlf

